<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado seleccionado -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimary"/>
            <corners android:radius="15dp"/>
            <padding
                android:left="1dp"
                android:top="5dp"
                android:right="1dp"
                android:bottom="8dp"/>
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorGrey200"/>
            <stroke android:width="1dp" android:color="@color/colorGrey400"/>
            <corners android:radius="15dp"/>
            <padding
                android:left="1dp"
                android:top="5dp"
                android:right="1dp"
                android:bottom="8dp"/>
        </shape>
    </item>

</selector>
