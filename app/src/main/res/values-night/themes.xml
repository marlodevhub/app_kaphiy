<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base de la app (nocturno) -->
    <style name="Base.Theme.app_android" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores primarios y de la marca -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorBlack</item>
        <item name="colorPrimaryContainer">@color/colorGreen2</item>
        <item name="colorOnPrimaryContainer">@color/colorWhite</item>

        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorBlack</item>
        <item name="colorSecondaryContainer">@color/colorGreenLight</item>
        <item name="colorOnSecondaryContainer">@color/colorWhite</item>

        <!-- El color de fondo de la app -->
        <item name="android:colorBackground">@color/colorGrey100</item>
        <item name="colorSurface">@color/colorGrey200</item>
        <item name="colorOnSurface">@color/colorWhite</item>

        <!-- Configuración para las barras del sistema -->
        <!-- El sistema determinará automáticamente el color de los iconos basado en el contraste -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false
        </item> <!-- Iconos claros para tema oscuro -->
    </style>

    <!-- Tema principal de la app -->
    <style name="Theme.app_android" parent="Base.Theme.app_android" />
</resources>
